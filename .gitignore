# Keep all real evidence outside the checkout; these patterns are a backstop.
.DS_Store
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.aws/
private/
artifacts/
transform-output/
carddemo-atx-artifacts/
test_plan.json
*-task-artifact.json
*.log
node_modules/
__pycache__/

# Operational pilot records belong outside this checkout.
/evidence/
/local-pilots/
/runs/

# Local editable CLI installation metadata.
*.egg-info/
build/
dist/
.venv/

# Terraform state and local variable files stay on the machine that applied them.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
